---
import Default from '@astrojs/starlight/components/Hero.astro'

// The manual homepage provides its own layout in MDX. Other splash pages keep
// Starlight's hero, including its frontmatter and translation support.
const isHome = Astro.locals.starlightRoute.entry.data.doc_id === 'manual.home'
---

{!isHome && <Default {...Astro.props}><slot /></Default>}
